{
  "cleanupPeriodDays": 90,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "~/AppData/Local/Temp"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'UserPromptSubmit',additionalContext:'Reminder: follow the coding style preferences in ~/.claude/CLAUDE.md when writing or editing code. Re-read any files with uncommitted or manual changes before modifying them.'}}))\""
          },
          {
            "type": "command",
            "command": "node ~/.claude/scripts/usage-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/block-webfetch.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/usage-context.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/scripts/usage-statusline.mjs",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "cc-plugin-telemetry@builtin": false
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
